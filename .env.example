# WhatsApp Cloud API
# Copia este archivo a .env.local y rellena los valores.
# NUNCA commitees .env.local (está en .gitignore).
# Detalles en docs/05-whatsapp-setup.md

# Token que tú inventas; Meta lo usa al verificar el webhook (GET hub.challenge).
WHATSAPP_VERIFY_TOKEN=

# Token de acceso de la app de Meta para llamar a la Graph API.
WHATSAPP_ACCESS_TOKEN=

# ID del número de WhatsApp Business (no el número en sí).
WHATSAPP_PHONE_NUMBER_ID=

# App Secret de la app de Meta; valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# Opcional: ruta del archivo JSON de leads (default ./data/leads.json).
# LEADS_FILE=

# ── IA Generativa (Google Gemini) ─────────────────────────────────────────────
# API key GRATUITA: https://aistudio.google.com/apikey
# Sin esta key el bot funciona igual pero responde con las plantillas directas.
GEMINI_API_KEY=
