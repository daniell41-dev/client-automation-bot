# WhatsApp Cloud API
# Copia este archivo a .env.local y rellena los valores.
# NUNCA commitees .env.local (está en .gitignore).
# Detalles en docs/05-whatsapp-setup.md

# Token que tú inventas; Meta lo usa al verificar el webhook (GET hub.challenge).
WHATSAPP_VERIFY_TOKEN=

# Token de acceso de la app de Meta para llamar a la Graph API.
WHATSAPP_ACCESS_TOKEN=

# ID del número de WhatsApp Business (no el número en sí).
WHATSAPP_PHONE_NUMBER_ID=

# App Secret de la app de Meta; valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# Opcional: ruta del archivo JSON de leads (default ./data/leads.json).
# LEADS_FILE=

# ── IA Generativa (cadena de respaldo) ─────────────────────────────────────────
# Sin NINGUNA de estas keys el bot funciona igual, respondiendo con las
# plantillas directas (sin reformular el tono). Con varias configuradas, si la
# primera falla o se queda sin cuota, se prueba automáticamente la siguiente.
# Verifica que funciona con:  pnpm ai:doctor · Detalles: docs/11-proveedor-ia.md

# Primario recomendado (también para negocios en Venezuela): Gemini está en la
# lista OFICIAL de regiones soportadas por Google — cero riesgo de que cierren
# la cuenta por fuera de términos de servicio. Key gratis, sin tarjeta:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=            # default: gemini-2.5-flash-lite

# Respaldo. Key gratis, sin tarjeta: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=               # default: llama-3.1-8b-instant

# Respaldo opcional. Key gratis: https://cloud.cerebras.ai
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=           # default: llama3.1-8b

# Proveedor propio OpenAI-compatible (p. ej. Ollama). Deben ir las 3 juntas.
# AI_CUSTOM_BASE_URL=       # p. ej. http://localhost:11434/v1
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_MODEL=

# Orden de la cadena (default: gemini,groq,cerebras,custom).
# AI_PROVIDER_ORDER=

# ── Google Sheets (persistencia) ──────────────────────────────────────────────
# Almacena leads y memoria de conversación en una hoja de cálculo. Sin estas
# variables el bot cae a los archivos JSON locales (data/) y funciona igual.
# Paso a paso (incluido compartir la hoja con la cuenta de servicio):
#   docs/07-google-sheets.md

# ID de la hoja (de la URL: docs.google.com/spreadsheets/d/<ESTE_ID>/edit).
GOOGLE_SHEETS_SPREADSHEET_ID=

# Email de la cuenta de servicio (termina en .iam.gserviceaccount.com).
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada de la cuenta de servicio (campo "private_key" del JSON).
# Pégala entre comillas; los saltos de línea van como \n literales.
GOOGLE_PRIVATE_KEY=

# ── Supabase (SaaS: portal, back office, demo y almacén principal) ────────────
# Base de datos + auth del portal. Con estas variables, Supabase pasa a ser el
# almacén principal (prioridad sobre Google Sheets y JSON local).
# Setup completo: docs/08-supabase-saas.md
# Valores en: dashboard de Supabase → Settings → API.

# URL del proyecto (https://<ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key (segura para el navegador; RLS limita lo que puede leer).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOLO servidor, bypassa RLS. NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=
