# WhatsApp Cloud API
# Copia este archivo a .env.local y rellena los valores.
# NUNCA commitees .env.local (está en .gitignore).
# Detalles en docs/05-whatsapp-setup.md

# Token que tú inventas; Meta lo usa al verificar el webhook (GET hub.challenge).
WHATSAPP_VERIFY_TOKEN=

# Token de acceso de la app de Meta para llamar a la Graph API.
WHATSAPP_ACCESS_TOKEN=

# ID del número de WhatsApp Business (no el número en sí).
WHATSAPP_PHONE_NUMBER_ID=

# App Secret de la app de Meta; valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# Opcional: ruta del archivo JSON de leads (default ./data/leads.json).
# LEADS_FILE=

# ── IA Generativa (Groq) ──────────────────────────────────────────────────────
# API key GRATUITA, sin tarjeta y disponible en Colombia: https://console.groq.com/keys
# Sin esta key el bot funciona igual pero responde con las plantillas directas.
# Verifica que funciona con:  pnpm ai:doctor
GROQ_API_KEY=

# Opcional: modelo de Groq a usar (default: llama-3.3-70b-versatile).
# Alternativa más rápida: llama-3.1-8b-instant
# GROQ_MODEL=

# ── Google Sheets (persistencia) ──────────────────────────────────────────────
# Almacena leads y memoria de conversación en una hoja de cálculo. Sin estas
# variables el bot cae a los archivos JSON locales (data/) y funciona igual.
# Paso a paso (incluido compartir la hoja con la cuenta de servicio):
#   docs/07-google-sheets.md

# ID de la hoja (de la URL: docs.google.com/spreadsheets/d/<ESTE_ID>/edit).
GOOGLE_SHEETS_SPREADSHEET_ID=

# Email de la cuenta de servicio (termina en .iam.gserviceaccount.com).
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada de la cuenta de servicio (campo "private_key" del JSON).
# Pégala entre comillas; los saltos de línea van como \n literales.
GOOGLE_PRIVATE_KEY=
