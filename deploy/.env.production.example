# T-61: copiar a deploy/.env.production en el VPS y completar. NUNCA commitear
# el .env.production (está en .gitignore y en .dockerignore).

# ── Del servidor ───────────────────────────────────────────────────────────
# Versión desplegada. La reescribe el despliegue automático (T-74): no tocar.
NEXO_VERSION=v1.0.0
# El dominio que apunta al VPS. Sin dominio propio: la IP con guiones +
# .sslip.io (ej. 100-23-146-236.sslip.io), que apunta sola a esa IP.
DOMINIO=bot.tudominio.com
# Correo para Let's Encrypt (avisos de vencimiento del certificado).
ACME_EMAIL=tucorreo@gmail.com

# ── Públicas ───────────────────────────────────────────────────────────────
# Se incrustan al compilar, así que GitHub las necesita como secretos del repo
# (ver docs/19-vps.md). Acá también, para el código que corre en el servidor.
NEXT_PUBLIC_SITE_URL=https://bot.tudominio.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# T-80: landing. Opcionales: sin el número, los botones de WhatsApp van a /demo.
NEXT_PUBLIC_WHATSAPP_VENTAS=
NEXT_PUBLIC_INSTAGRAM=
# T-90: opcional. ID de Microsoft Clarity; sin él la landing no mide nada.
NEXT_PUBLIC_CLARITY_ID=

# ── Secretas (las mismas de tu .env.local) ─────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_APROBACION=aviso_pedido_aprobacion
WHATSAPP_TEMPLATE_IDIOMA=es
WHATSAPP_TEMPLATE_BOTONES=true
GEMINI_API_KEY=
# GROQ_API_KEY=
# GEMINI_MODEL=
